generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native","linux-musl-openssl-3.0.x"]
  // what openSSL binaries to use by prisma to ensure secure comms with DB.
  // native: use the installed dependencies for the dev
  // linux-musl-openssl-3.0.x : the installed version in the prod container
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email    String @id
  username String
  password String
  todos    Todo[]
}

model Todo {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime
  isDone      Boolean  @default(false)
  userEmail   String
  user        User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
}
